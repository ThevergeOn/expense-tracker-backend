generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  description String
  amount      Decimal
  category    String   @default("General")

  @@map("expenses")
}

model Budget {
  id     Int     @id @default(autoincrement())
  month  Int     @unique
  amount Decimal

  @@map("budgets")
}
