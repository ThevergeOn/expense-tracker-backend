generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id        Int      @id @default(autoincrement())
  title     String
  category  String   @default("other")
  amount    Decimal
  date      DateTime @db.Date
  type      String   @default("expense")
  icon      String?
  iconColor String?
  iconBg    String?

  @@map("transactions")
}

model Budget {
  id     Int     @id @default(autoincrement())
  month  Int     @unique
  amount Decimal

  @@map("budgets")
}
